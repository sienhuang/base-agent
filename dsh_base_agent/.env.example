# HTTP listener. Keep loopback unless authentication and network controls are configured.
BASE_AGENT_HOST=127.0.0.1
BASE_AGENT_PORT=8000

# Local workspace and durable Base Agent state.
BASE_AGENT_WORKSPACE=.
BASE_AGENT_STATE_DIR=.base-agent/state

# Multi-Agent registry. Relative paths resolve from the server working directory.
BASE_AGENT_CONFIG=agents.yaml

# Single-Agent fallback, used only when BASE_AGENT_CONFIG is blank or unset.
BASE_AGENT_NAME=assistant
BASE_AGENT_INSTRUCTIONS="You are the application assistant."

# Context policy: compacting or keep-all.
BASE_AGENT_CONTEXT_POLICY=compacting
BASE_AGENT_COMPACTION_THRESHOLD_RATIO=0.8
BASE_AGENT_COMPACTION_RETAIN_RATIO=0.16

# Single-Agent fallback route/model. Multi-Agent values come from agents.yaml.
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
# Provider endpoint and credential remain process environment variables shared by Agents.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Optional DSH request and Runtime controls. Blank means unset.
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=
DSH_BIN=
DSH_INITIALIZE_TIMEOUT_SECONDS=30
DSH_REQUEST_TIMEOUT_SECONDS=
DSH_SHUTDOWN_TIMEOUT_SECONDS=5
