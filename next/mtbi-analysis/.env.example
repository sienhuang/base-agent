AGENT_PROVIDER=codex-cli
AGENT_CLI_EXECUTABLE=codex
AGENT_CLI_TIMEOUT_SECONDS=300
AGENT_CLI_MAX_OUTPUT_BYTES=4194304
AGENT_MAX_TOOL_OBSERVATION_BYTES=32768
AGENT_MAX_RUN_OBSERVATION_BYTES=524288

# Optional. Omit AGENT_MODEL to use the Codex CLI default model.
# AGENT_MODEL=YOUR_CODEX_MODEL

# Optional OpenAI-compatible mode:
# AGENT_PROVIDER=openai-compatible
# OPENAI_API_KEY=YOUR_API_KEY
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
# OPENAI_MODEL=YOUR_MODEL_NAME
MTBI_STRUCTURED_OUTPUT_MODE=prompt

# Optional. Defaults to resolving mtbi-cli from PATH.
# MTBI_CLI_BIN=/absolute/path/to/mtbi-cli

# Optional. Relative paths are resolved from this application directory.
MTBI_WORKSPACE=workspace
MTBI_CLI_TIMEOUT_SECONDS=600
MTBI_MAX_ARTIFACT_BYTES=10485760
MTBI_MAX_CSV_ROWS=100000
