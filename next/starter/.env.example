# Copy this file to next/starter/.env. Process environment variables take
# precedence over values declared in that local file.

AGENT_PROVIDER=openai-compatible
AGENT_MODEL=YOUR_MODEL_NAME
OPENAI_API_KEY=YOUR_API_KEY

# Optional plan-react role routes. Every omitted value inherits the shared setting.
# PLAN_REACT_PLANNER_MODEL=YOUR_PLANNER_MODEL_NAME
# PLAN_REACT_EXECUTOR_MODEL=YOUR_EXECUTOR_MODEL_NAME
# PLAN_REACT_PLANNER_BASE_URL=https://planner.example/v1
# PLAN_REACT_EXECUTOR_BASE_URL=https://executor.example/v1
# PLAN_REACT_PLANNER_API_KEY=YOUR_PLANNER_API_KEY
# PLAN_REACT_EXECUTOR_API_KEY=YOUR_EXECUTOR_API_KEY
# PLAN_REACT_PLANNER_STRUCTURED_OUTPUT_MODE=json-schema
# PLAN_REACT_EXECUTOR_STRUCTURED_OUTPUT_MODE=prompt

# Broadest Chat Completions compatibility. The SDK still validates the final
# JSON locally against the Agent's Pydantic response model.
AGENT_STRUCTURED_OUTPUT_MODE=prompt

# Set this only for a compatible service other than OpenAI's default endpoint.
# OPENAI_BASE_URL=https://your-compatible-service.example/v1

# Local authenticated CLI alternative (no API key required):
# AGENT_PROVIDER=codex-cli
# AGENT_CLI_TIMEOUT_SECONDS=300
# AGENT_CLI_MAX_OUTPUT_BYTES=4194304
